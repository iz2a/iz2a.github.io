# ============================================================
# MIRSAD: Environment Variables
# Copy to .env.local and fill in your values
# NEVER commit .env.local to git
# ============================================================

# ── SUPABASE ─────────────────────────────────────────────────
# Get from: https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── ANTHROPIC AI ─────────────────────────────────────────────
# Get from: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# ── SERVICENOW ───────────────────────────────────────────────
# Your ServiceNow instance URL (no trailing slash)
SERVICENOW_BASE_URL=https://YOUR_INSTANCE.service-now.com
SERVICENOW_USERNAME=your_username
SERVICENOW_PASSWORD=your_password
# OR use OAuth token:
# SERVICENOW_TOKEN=Bearer eyJ...

# ── JIRA ─────────────────────────────────────────────────────
# Jira Cloud: https://YOUR_DOMAIN.atlassian.net
JIRA_BASE_URL=https://YOUR_DOMAIN.atlassian.net
JIRA_EMAIL=your@email.com
JIRA_API_TOKEN=your_jira_api_token
JIRA_PROJECT_KEY=GRC

# ── APP CONFIG ───────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=MIRSAD
